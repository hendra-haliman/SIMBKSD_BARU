package id.go.jakarta.bksd.dokumen;

import net.datafaker.Faker;
import org.springframework.boot.CommandLineRunner;
import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
import org.springframework.stereotype.Component;

import id.go.jakarta.bksd.dokumen.domain.Alamat;
import id.go.jakarta.bksd.dokumen.domain.Pemakai;
import id.go.jakarta.bksd.dokumen.repository.PemakaiRepository;

import java.util.List;
import java.util.Locale;
import java.util.stream.IntStream;

@Component
@ConditionalOnProperty(name = "populate.fake.data")
public class SampleDataLoader implements CommandLineRunner {
    private final Faker faker;
    private PemakaiRepository pemakaiRepository;

    public SampleDataLoader(PemakaiRepository pemakaiRepository) {
        this.faker = new Faker(new Locale("id"));
        this.pemakaiRepository = pemakaiRepository;
    }

    @Override
    public void run(String... args) throws Exception {
        String[] jabatan = { "Staff", "Tenaga Ahli", "Manager", "Kontraktor" };
        String[] titles = { "Ir.", "", "Dr." };
        String[] rt = {
                "001", "002", "003", "004", "005", "006", "007", "008", "009",
                "011", "012", "013", "014", "015", "016", "017", "018", "019"
        };

        String[] rw = rt;

        List<Pemakai> users = IntStream.rangeClosed(1, 2000)
                .mapToObj(i -> new Pemakai(
                        faker.options().option(titles),
                        faker.options().option(jabatan),
                        faker.name().firstName(),
                        faker.name().lastName(),
                        "", // email
                        "", // password
                        true))
                .toList();
        pemakaiRepository.saveAll(users);
    }
}
